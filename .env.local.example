# Copy this file to .env.local and fill in your own values. Never commit real
# service-role or provider API keys.

# Clerk and Supabase are required. Mock speech and extraction do not require
# paid AI provider keys.

# --- Clerk ---------------------------------------------------------------
# `clerk init` / `clerk env pull` writes these for the linked application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Set the deployed app origin on the separate transcription service too.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase -------------------------------------------------------------
# Create the project in the Mumbai (ap-south-1) region. ABDM's Health Data
# Management Policy requires patient data to stay inside India, and a project's
# region is fixed at creation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Safe in the browser: RLS is what protects the data, not this key.
# Older projects call this the anon key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Bypasses RLS entirely — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: an existing Clerk development account linked to a test clinic.
E2E_DOCTOR_EMAIL=

# --- Speech to text -------------------------------------------------------
# https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=

# Optional fallback provider. Leave blank for an ElevenLabs-only deployment.
SARVAM_API_KEY=

# elevenlabs | sarvam | mock
STT_PROVIDER=mock

# --- LLM ------------------------------------------------------------------
# openai | gemini | anthropic | mock
LLM_PROVIDER=mock

# OpenAI or Azure OpenAI v1 (server-only credentials).
OPENAI_API_KEY=
# For Azure, use the resource's /openai/v1 endpoint.
# OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
OPENAI_MODEL=gpt-6-astra
OPENAI_FAST_MODEL=gpt-6-astra

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=

# Anthropic Console: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Legacy switch: 1 enables deterministic offline extraction.
LLM_MOCK=1

# --- Live transcription proxy --------------------------------------------
# In production, deploy the WebSocket proxy separately and use a wss:// URL.
NEXT_PUBLIC_STT_PROXY_URL=ws://localhost:8787
STT_PROXY_PORT=8787
