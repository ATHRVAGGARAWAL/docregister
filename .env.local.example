# Copy this file to .env.local and fill in your own values. Never commit real
# service-role or provider API keys.

# The app runs end to end with only the two Supabase values below: leave
# STT_PROVIDER=mock and LLM_PROVIDER=mock and the dictate -> review -> commit
# loop works offline without paid provider keys.

# --- Supabase -------------------------------------------------------------
# Create the project in the Mumbai (ap-south-1) region. ABDM's Health Data
# Management Policy requires patient data to stay inside India, and a project's
# region is fixed at creation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Safe in the browser: RLS is what protects the data, not this key.
# Older projects call this the anon key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Bypasses RLS entirely — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Speech to text -------------------------------------------------------
# https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=

# Optional fallback provider. Leave blank for an ElevenLabs-only deployment.
SARVAM_API_KEY=

# elevenlabs | sarvam | mock
STT_PROVIDER=mock

# --- LLM ------------------------------------------------------------------
# gemini | anthropic | mock
LLM_PROVIDER=mock

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=

# Anthropic Console: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Legacy switch: 1 enables deterministic offline extraction.
LLM_MOCK=1

# --- Live transcription proxy --------------------------------------------
# In production, deploy the WebSocket proxy separately and use a wss:// URL.
NEXT_PUBLIC_STT_PROXY_URL=ws://localhost:8787
STT_PROXY_PORT=8787
