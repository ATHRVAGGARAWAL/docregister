# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the sanitized example is intentionally committed)
.env*
!.env.local.example

# local agent and connector settings
/.claude/
/.mcp.json

# generated demo recordings, screenshots, logs, and local stack state
/demo/
/supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.21st/

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Throwaway probe scripts. Agents and humans both write one-off measurement
# harnesses at the repo root; several have been committed by accident. Anything
# matching these is scratch by construction — name it otherwise if it is real.
/a11y-*.mts
/a11y-*.js
/theme-*.mts
/theme-harness-*.tsx
/zz-*
/probe-*
/measure-*
/shot*.mjs
/csscheck.mjs
/findbad.mjs
